# Game server configuration — loaded at runtime by the Node process
# (server/index.mjs). These values are NEVER shipped to the browser or
# included in the built JS bundle. On Render / Railway / a VPS, set the same
# variables as platform environment variables instead of a .env file.

# Port for the game server (serves the frontend + API on one port)
PORT=8080

# Full request URL of the classroom Jev endpoint (Decisions / System One API)
JEV_API_URL=https://openrouter.ai/api/alpha/decisions

# API key for that endpoint (e.g. an OpenRouter key) — stays on the server
JEV_API_KEY=sk-or-v1-your-key-here

# Model id served at that endpoint
JEV_MODEL=typesafe/jev-1.14
